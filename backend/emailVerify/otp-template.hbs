<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light" />

    <title>{{purpose}}</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            min-width: 100%;
            background-color: #f7f5ff;
            font-family:
                "Segoe UI",
                Arial,
                Helvetica,
                sans-serif;
            color: #1f2937;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
        }

        img {
            border: 0;
            outline: none;
            text-decoration: none;
            max-width: 100%;
        }

        a {
            text-decoration: none;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f7f5ff;
            padding: 40px 16px;
        }

        .container {
            width: 100%;
            max-width: 560px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e8e3ff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow:
                0 20px 55px rgba(76, 29, 149, 0.12);
        }

        /* Top gradient */
        .top-line {
            height: 5px;
            line-height: 5px;
            font-size: 0;
            background:
                linear-gradient(90deg,
                    #7c3aed 0%,
                    #c026d3 50%,
                    #3b82f6 100%);
        }

        /* Header */
        .header {
            text-align: center;
            padding: 34px 28px 26px;
            background-color: #ffffff;
        }

        .logo {
            width: 58px;
            height: 58px;
            margin: 0 auto;
            border-radius: 16px;
            background:
                linear-gradient(135deg,
                    #7c3aed,
                    #3b82f6);
            color: #ffffff;
            font-size: 25px;
            line-height: 58px;
            text-align: center;
            font-weight: 700;
            box-shadow:
                0 8px 22px rgba(124, 58, 237, 0.25);
        }

        .brand {
            margin-top: 15px;
            font-size: 13px;
            line-height: 20px;
            font-weight: 700;
            color: #7c3aed;
            letter-spacing: 0.3px;
        }

        .header-title {
            margin: 7px 0 0;
            font-size: 27px;
            line-height: 36px;
            font-weight: 800;
            color: #1f2937;
        }

        .header-subtitle {
            margin: 7px 0 0;
            font-size: 13px;
            line-height: 20px;
            color: #9ca3af;
        }

        .gradient-divider {
            width: 48px;
            height: 3px;
            margin: 13px auto 0;
            border-radius: 10px;
            background:
                linear-gradient(90deg,
                    #7c3aed,
                    #3b82f6);
        }

        /* Body */
        .body {
            padding: 0 34px 32px;
            color: #374151;
            font-size: 14px;
            line-height: 23px;
        }

        .body p {
            margin: 0 0 15px;
        }

        .greeting {
            color: #374151;
            font-size: 15px;
            font-weight: 500;
        }

        .description {
            color: #6b7280;
        }

        /* OTP */
        .otp-wrapper {
            padding: 5px 0 22px;
            text-align: center;
        }

        .otp-box {
            display: inline-block;
            min-width: 210px;
            box-sizing: border-box;
            padding: 19px 24px;
            border-radius: 14px;
            background-color: #faf9ff;
            border: 1px solid #e7e1ff;
            color: #4c1d95;
            font-size: 31px;
            line-height: 38px;
            font-weight: 800;
            letter-spacing: 7px;
            text-align: center;
            box-shadow:
                0 7px 20px rgba(124, 58, 237, 0.08);
        }

        /* Expiry */
        .expiry-box {
            margin: 4px 0 22px;
            padding: 13px 15px;
            background-color: #f5f3ff;
            border-left: 3px solid #7c3aed;
            border-radius: 9px;
        }

        .expiry-box p {
            margin: 0;
            font-size: 12px;
            line-height: 19px;
            color: #6b7280;
        }

        .expiry-box strong {
            color: #4c1d95;
        }

        /* Security */
        .security-text {
            margin-top: 20px !important;
            font-size: 12px;
            line-height: 20px;
            color: #9ca3af;
        }

        .security-text strong {
            color: #6b7280;
        }

        /* CTA */
        .button-wrapper {
            padding: 3px 0 4px;
            text-align: center;
        }

        .btn {
            display: inline-block;
            padding: 13px 25px;
            border-radius: 10px;
            background:
                linear-gradient(90deg,
                    #7c3aed 0%,
                    #c026d3 50%,
                    #3b82f6 100%);
            color: #ffffff !important;
            font-size: 13px;
            line-height: 19px;
            font-weight: 700;
            text-decoration: none;
            box-shadow:
                0 7px 18px rgba(124, 58, 237, 0.22);
        }

        /* Footer */
        .footer {
            padding: 22px 25px;
            background-color: #faf9ff;
            border-top: 1px solid #eeeaff;
            text-align: center;
            color: #9ca3af;
        }

        .footer-main {
            margin: 0 0 6px;
            font-size: 11px;
            line-height: 18px;
        }

        .footer-note {
            margin: 0;
            font-size: 10px;
            line-height: 17px;
            color: #b0b4bd;
        }

        .bottom-text {
            margin: 17px 0 0;
            text-align: center;
            color: #a1a1aa;
            font-size: 10px;
            line-height: 16px;
        }

        /* Mobile */
        @media only screen and (max-width: 600px) {
            .email-wrapper {
                padding: 20px 10px;
            }

            .container {
                border-radius: 18px;
            }

            .header {
                padding: 28px 20px 22px;
            }

            .header-title {
                font-size: 24px;
                line-height: 32px;
            }

            .body {
                padding: 0 22px 26px;
            }

            .otp-box {
                min-width: 190px;
                padding: 17px 18px;
                font-size: 27px;
                letter-spacing: 5px;
            }

            .btn {
                max-width: 90%;
            }
        }
    </style>
</head>

<body>

    <!-- Email Wrapper -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="
      width: 100%;
      background-color: #f7f5ff;
    ">
        <tr>
            <td align="center" style="padding: 40px 16px;">

                <!-- Main Container -->
                <table role="presentation" class="container" width="100%" cellpadding="0" cellspacing="0" border="0">

                    <!-- Top Gradient -->
                    <tr>
                        <td class="top-line" style="
                height: 5px;
                line-height: 5px;
                font-size: 0;
              ">
                            &nbsp;
                        </td>
                    </tr>

                    <!-- Header -->
                    <tr>
                        <td class="header">

                            <!-- Logo -->
                            <div class="logo">
                                ✨
                            </div>

                            <!-- Brand -->
                            <div class="brand">
                                {{APP_NAME}}
                            </div>

                            <!-- Title -->
                            <h1 class="header-title">
                                Verify Your Account
                            </h1>

                            <!-- Subtitle -->
                            <div class="header-subtitle">
                                Complete your signup securely
                            </div>

                            <!-- Divider -->
                            <div class="gradient-divider"></div>

                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td class="body">

                            <!-- Greeting -->
                            <p class="greeting">
                                👋 Welcome to
                                <strong>{{APP_NAME}}</strong>
                            </p>

                            <!-- Description -->
                            <p class="description">
                                To complete your signup, please
                                verify your email address using
                                the verification code below.
                            </p>

                            <!-- OTP -->
                            <div class="otp-wrapper">

                                <div class="otp-box">
                                    {{otp}}
                                </div>

                            </div>

                            <!-- Expiry -->
                            <div class="expiry-box">

                                <p>
                                    <strong>
                                        This OTP is valid for
                                        10 minutes.
                                    </strong>
                                    <br />

                                    Keep it secure and do not share
                                    it with anyone.
                                </p>

                            </div>

                            <!-- Security Message -->
                            <p class="security-text">

                                You're receiving this email because
                                a verification code was requested
                                for your
                                <strong>{{APP_NAME}}</strong>
                                account.

                                If this wasn't you, please ignore
                                this email.

                            </p>

                            <!-- CTA -->
                            <div class="button-wrapper">

                                <a href="{{website_url}}" target="_blank" rel="noopener noreferrer" class="btn">
                                    Visit {{APP_NAME}}
                                </a>

                            </div>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td class="footer">

                            <p class="footer-main">
                                &copy; {{year}}
                                {{APP_NAME}}.
                                All rights reserved.
                            </p>

                            <p class="footer-note">
                                This is an automated email.
                                Please do not reply.
                            </p>

                        </td>
                    </tr>

                </table>

                <!-- Bottom Label -->
                <p class="bottom-text">
                    Account Verification · {{APP_NAME}}
                </p>

            </td>
        </tr>
    </table>

</body>

</html>